{
  "containerDiskInGb": 20,
  "dockerEntrypoint": [
    "/bin/sh",
    "-c",
    "if [ -d /runpod-volume/weights ] && [ ! -e /workspace/weights ]; then mkdir -p /workspace && ln -s /runpod-volume/weights /workspace/weights; fi; exec /opt/fastvideo-rs/bin/fv-serve \"$@\"",
    "fv-serve"
  ],
  "dockerStartCmd": [
    "--config",
    "/etc/fv/runpod.toml"
  ],
  "env": {
    "FV_AUTH_MODE": "trust-gateway",
    "FV_CACHE_DIR": "/fvstate/cache",
    "FV_CF_ACCOUNT_ID": "{{ RUNPOD_SECRET_fv_cf_account_id }}",
    "FV_CF_API_TOKEN": "{{ RUNPOD_SECRET_fv_cf_api_token }}",
    "FV_D1_DATABASE_ID": "{{ RUNPOD_SECRET_fv_d1_database_id }}",
    "FV_IMAGE_DIGEST": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
    "FV_IMAGE_REF": "ghcr.io/zaitrarrio/fastvideo-rs-serve@sha256:1111111111111111111111111111111111111111111111111111111111111111",
    "FV_R2_ACCESS_KEY_ID": "{{ RUNPOD_SECRET_fv_r2_access_key_id }}",
    "FV_R2_BUCKET": "{{ RUNPOD_SECRET_fv_r2_bucket }}",
    "FV_R2_ENDPOINT": "{{ RUNPOD_SECRET_fv_r2_endpoint }}",
    "FV_R2_SECRET_ACCESS_KEY": "{{ RUNPOD_SECRET_fv_r2_secret_access_key }}",
    "FV_SERVE_MODE": "runpod-queue",
    "FV_STATE_DIR": "/fvstate",
    "FV_WEBHOOK_ED25519_KEY": "{{ RUNPOD_SECRET_fv_webhook_ed25519_key }}",
    "FV_WEIGHTS": "/runpod-volume/weights",
    "RUST_LOG": "info"
  },
  "imageName": "ghcr.io/zaitrarrio/fastvideo-rs-serve@sha256:1111111111111111111111111111111111111111111111111111111111111111",
  "isServerless": true,
  "name": "fv-serve-plan",
  "volumeInGb": 0
}
