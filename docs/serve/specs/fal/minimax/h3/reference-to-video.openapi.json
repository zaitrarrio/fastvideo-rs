{
  "components": {
    "schemas": {
      "File": {
        "properties": {
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The mime type of the file.",
            "examples": [
              "image/png"
            ],
            "title": "Content Type"
          },
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "title": "File Name"
          },
          "file_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The size of the file in bytes.",
            "examples": [
              4404019
            ],
            "title": "File Size"
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "File",
        "type": "object",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ]
      },
      "H3ReferenceToVideoInput": {
        "properties": {
          "aspect_ratio": {
            "default": "adaptive",
            "description": "The aspect ratio of the generated video.",
            "enum": [
              "adaptive",
              "21:9",
              "16:9",
              "4:3",
              "1:1",
              "3:4",
              "9:16"
            ],
            "title": "Aspect Ratio",
            "type": "string"
          },
          "duration": {
            "default": 5,
            "description": "The duration of the video in seconds.",
            "maximum": 15,
            "minimum": 5,
            "title": "Duration",
            "type": "integer"
          },
          "enable_safety_checker": {
            "default": true,
            "description": "If set to true, the safety checker will be enabled.",
            "title": "Enable Safety Checker",
            "type": "boolean"
          },
          "prompt": {
            "description": "Text prompt for video generation. Refer to reference assets by their modality and order in the reference lists: Image 1, Image 2, Video 1, Audio 1, and so on.",
            "examples": [
              "Image 1 is the female protagonist. Image 2 is her small dog. Keep the woman and dog consistent with their respective reference images while they walk together through a sunlit garden."
            ],
            "maxLength": 50000,
            "minLength": 1,
            "title": "Prompt",
            "type": "string"
          },
          "prompt_expansion_mode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "balanced",
            "description": "How much effort to spend rewriting the prompt before generation. 'disabled' skips prompt expansion. 'fast' returns in about a second. 'balanced' picks per request. 'quality' spends up to ~30s on a richer prompt.",
            "examples": [
              "disabled",
              "fast",
              "balanced",
              "quality"
            ],
            "title": "Prompt Expansion Mode"
          },
          "reference_audio_urls": {
            "description": "URLs of reference audio clips (2-15 seconds each, combined duration at most 15 seconds), referenced in the prompt as Audio 1, Audio 2, and so on. Images, videos, and audio can be provided individually or together. Reference images, videos, and audio clips must add up to at most 12 files.",
            "items": {
              "type": "string"
            },
            "maxItems": 3,
            "title": "Reference Audio URLs",
            "type": "array"
          },
          "reference_image_urls": {
            "description": "URLs of subject/style reference images, referenced in the prompt as Image 1, Image 2, and so on. Reference images, videos, and audio clips must add up to at most 12 files.",
            "examples": [
              [
                "https://storage.googleapis.com/falserverless/example_inputs/hailuo23/pro_i2v_in.jpg"
              ]
            ],
            "items": {
              "type": "string"
            },
            "maxItems": 9,
            "title": "Reference Image URLs",
            "type": "array"
          },
          "reference_video_urls": {
            "description": "URLs of motion/reference video clips (2-15 seconds each, combined duration at most 15 seconds), referenced in the prompt as Video 1, Video 2, and so on. Reference images, videos, and audio clips must add up to at most 12 files.",
            "items": {
              "type": "string"
            },
            "maxItems": 3,
            "title": "Reference Video URLs",
            "type": "array"
          },
          "resolution": {
            "default": "2K",
            "description": "The resolution of the generated video. 480P and 768P are native generation modes; 2K and 4K upscale a 768P base result.",
            "enum": [
              "480P",
              "768P",
              "2K",
              "4K"
            ],
            "title": "Resolution",
            "type": "string"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Random seed. A random seed is selected when omitted.",
            "title": "Seed"
          },
          "sync_mode": {
            "default": false,
            "description": "Return the generated video as base64 instead of a CDN URL.",
            "title": "Sync Mode",
            "type": "boolean"
          }
        },
        "required": [
          "prompt"
        ],
        "title": "ReferenceToVideoHailuo03Input",
        "type": "object",
        "x-fal-order-properties": [
          "prompt",
          "duration",
          "resolution",
          "seed",
          "enable_safety_checker",
          "sync_mode",
          "prompt_expansion_mode",
          "aspect_ratio",
          "reference_image_urls",
          "reference_video_urls",
          "reference_audio_urls"
        ]
      },
      "H3ReferenceToVideoOutput": {
        "properties": {
          "expanded_prompt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The prompt after expansion, as sent to the model. Null when prompt expansion was disabled, left the prompt unchanged, or was performed internally by MiniMax's hosted API.",
            "title": "Expanded Prompt"
          },
          "video": {
            "$ref": "#/components/schemas/File",
            "description": "The generated video"
          }
        },
        "required": [
          "video"
        ],
        "title": "ReferenceToVideoHailuo03Output",
        "type": "object",
        "x-fal-order-properties": [
          "video",
          "expanded_prompt"
        ]
      },
      "QueueStatus": {
        "properties": {
          "cancel_url": {
            "description": "The cancel url.",
            "type": "string"
          },
          "logs": {
            "additionalProperties": true,
            "description": "The logs.",
            "type": "object"
          },
          "metrics": {
            "additionalProperties": true,
            "description": "The metrics.",
            "type": "object"
          },
          "queue_position": {
            "description": "The queue position.",
            "type": "integer"
          },
          "request_id": {
            "description": "The request id.",
            "type": "string"
          },
          "response_url": {
            "description": "The response url.",
            "type": "string"
          },
          "status": {
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ],
            "type": "string"
          },
          "status_url": {
            "description": "The status url.",
            "type": "string"
          }
        },
        "required": [
          "status",
          "request_id"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "apiKeyAuth": {
        "description": "Fal Key",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "The OpenAPI schema for the minimax/h3/reference-to-video queue.",
    "title": "Queue OpenAPI for minimax/h3/reference-to-video",
    "version": "1.0.0",
    "x-fal-metadata": {
      "about": "Reference To Video Hailuo 03",
      "category": "image-to-video",
      "documentationUrl": "https://fal.ai/models/minimax/h3/reference-to-video/api",
      "endpointId": "minimax/h3/reference-to-video",
      "playgroundUrl": "https://fal.ai/models/minimax/h3/reference-to-video",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0aa42dcf/3VDKabd7ifjCezrQpdfEI.jpg"
    }
  },
  "openapi": "3.0.4",
  "paths": {
    "/minimax/h3/reference-to-video": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/H3ReferenceToVideoInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            },
            "description": "The request status."
          }
        }
      }
    },
    "/minimax/h3/reference-to-video/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/H3ReferenceToVideoOutput"
                }
              }
            },
            "description": "Result of the request."
          }
        }
      }
    },
    "/minimax/h3/reference-to-video/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "description": "Whether the request was cancelled successfully.",
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The request was cancelled."
          }
        }
      }
    },
    "/minimax/h3/reference-to-video/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "logs",
            "required": false,
            "schema": {
              "description": "Whether to include logs (`1`) in the response or not (`0`).",
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            },
            "description": "The request status."
          }
        }
      }
    }
  },
