{
  "components": {
    "schemas": {
      "File": {
        "properties": {
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The mime type of the file.",
            "examples": [
              "image/png"
            ],
            "title": "Content Type"
          },
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "title": "File Name"
          },
          "file_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The size of the file in bytes.",
            "examples": [
              4404019
            ],
            "title": "File Size"
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "File",
        "type": "object",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ]
      },
      "H3MaxReferenceToVideoInput": {
        "properties": {
          "aspect_ratio": {
            "default": "adaptive",
            "description": "The aspect ratio of the generated video.",
            "enum": [
              "adaptive",
              "21:9",
              "16:9",
              "4:3",
              "1:1",
              "3:4",
              "9:16"
            ],
            "title": "Aspect Ratio",
            "type": "string"
          },
          "duration": {
            "default": 5,
            "description": "Video length in seconds. The output can run up to about 0.7 s longer than requested.",
            "maximum": 15,
            "minimum": 0.92,
            "title": "Duration",
            "type": "number"
          },
          "enable_safety_checker": {
            "default": true,
            "description": "If set to true, the safety checker will be enabled.",
            "title": "Enable Safety Checker",
            "type": "boolean"
          },
          "end_image_url": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional URL of the image to use as the last frame. The video ends exactly on this image.",
            "title": "End Image URL"
          },
          "image_url": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional URL of the image to use as the first frame. The video opens exactly on this image while the references keep the subjects consistent; the output canvas follows this image.",
            "title": "Start Image URL"
          },
          "middle_frame_time": {
            "anyOf": [
              {
                "exclusiveMaximum": 15,
                "exclusiveMinimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Target time for the middle image, in seconds from the start. Rounded to the nearest frame at 24 fps; it must fall strictly between the first and last frames of the requested duration. Requires middle_image_url.",
            "examples": [
              2.5
            ],
            "title": "Time (seconds)"
          },
          "middle_image_url": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional image to guide the video at middle_frame_time. Requires start and end images and native 480P or 768P resolution.",
            "title": "Middle Image"
          },
          "prompt": {
            "description": "Text prompt for video generation. Refer to reference assets by their modality and order in the reference lists: Image 1, Image 2, Video 1, Audio 1, and so on.",
            "examples": [
              "Image 1 is the female protagonist. Image 2 is her small dog. Keep the woman and dog consistent with their respective reference images while they walk together through a sunlit garden."
            ],
            "maxLength": 50000,
            "minLength": 1,
            "title": "Prompt",
            "type": "string"
          },
          "prompt_expansion_mode": {
            "default": "balanced",
            "description": "How much effort to spend rewriting the prompt before generation. 'disabled' skips prompt expansion. 'balanced' returns in about a second. 'quality' spends up to ~30s on a richer prompt.",
            "examples": [
              "disabled",
              "balanced",
              "quality"
            ],
            "title": "Prompt Expansion Mode",
            "type": "string"
          },
          "reference_audio_urls": {
            "description": "URLs of reference audio clips (2-15 seconds each, combined duration at most 15 seconds), referenced in the prompt as Audio 1, Audio 2, and so on. Images, videos, and audio can be provided individually or together. Reference images, videos, and audio clips must add up to at most 12 files.",
            "items": {
              "type": "string"
            },
            "maxItems": 3,
            "title": "Reference Audio URLs",
            "type": "array"
          },
          "reference_conditions": {
            "description": "Ordered reference list; cross-modality order is semantic and is preserved end-to-end. Do not combine with reference_*_urls.",
            "items": {
              "$ref": "#/components/schemas/ReferenceCondition"
            },
            "maxItems": 12,
            "title": "Reference Conditions",
            "type": "array"
          },
          "reference_image_urls": {
            "description": "URLs of subject/style reference images, referenced in the prompt as Image 1, Image 2, and so on. Reference images, videos, and audio clips must add up to at most 12 files.",
            "examples": [
              [
                "https://storage.googleapis.com/falserverless/example_inputs/hailuo23/pro_i2v_in.jpg"
              ]
            ],
            "items": {
              "type": "string"
            },
            "maxItems": 9,
            "title": "Reference Image URLs",
            "type": "array"
          },
          "reference_video_urls": {
            "description": "URLs of motion/reference video clips (2-15 seconds each, combined duration at most 15 seconds), referenced in the prompt as Video 1, Video 2, and so on. Reference images, videos, and audio clips must add up to at most 12 files.",
            "items": {
              "type": "string"
            },
            "maxItems": 3,
            "title": "Reference Video URLs",
            "type": "array"
          },
          "resolution": {
            "default": "768P",
            "description": "The native generation resolution, or 1080P latent refinement from a native 768P source.",
            "enum": [
              "480P",
              "768P",
              "1080P"
            ],
            "title": "Resolution",
            "type": "string"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Random seed. A random seed is selected when omitted.",
            "title": "Seed"
          },
          "sync_mode": {
            "default": false,
            "description": "Return the generated video as base64 instead of a CDN URL.",
            "title": "Sync Mode",
            "type": "boolean"
          }
        },
        "required": [
          "prompt",
          "prompt_expansion_mode"
        ],
        "title": "TurboReferenceToVideoHailuo03Input",
        "type": "object",
        "x-fal-order-properties": [
          "prompt",
          "reference_image_urls",
          "reference_video_urls",
          "reference_audio_urls",
          "image_url",
          "middle_image_url",
          "middle_frame_time",
          "end_image_url",
          "duration",
          "resolution",
          "seed",
          "enable_safety_checker",
          "sync_mode",
          "prompt_expansion_mode",
          "aspect_ratio",
          "reference_conditions"
        ]
      },
      "H3MaxReferenceToVideoOutput": {
        "properties": {
          "expanded_prompt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The prompt after expansion, as sent to the model. Null when prompt expansion was disabled, left the prompt unchanged, or was performed internally by MiniMax's hosted API.",
            "title": "Expanded Prompt"
          },
          "reference_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Packed reference conditioner rows encoded for this request (images, videos, keyframes, and audio). The first 4096 rows are included in the clip price.",
            "title": "Reference Tokens"
          },
          "seed": {
            "description": "Base seed for reproducing the generation.",
            "title": "Seed",
            "type": "integer"
          },
          "timings": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Timing breakdown in seconds. 'inference' is the DiT denoising time on the GPU backend. Null on routes that do not report backend timings.",
            "title": "Timings"
          },
          "video": {
            "$ref": "#/components/schemas/File",
            "description": "The generated video"
          }
        },
        "required": [
          "video",
          "seed"
        ],
        "title": "TurboReferenceToVideoHailuo03Output",
        "type": "object",
        "x-fal-order-properties": [
          "video",
          "expanded_prompt",
          "seed",
          "reference_tokens",
          "timings"
        ]
      },
      "QueueStatus": {
        "properties": {
          "cancel_url": {
            "description": "The cancel url.",
            "type": "string"
          },
          "logs": {
            "additionalProperties": true,
            "description": "The logs.",
            "type": "object"
          },
          "metrics": {
            "additionalProperties": true,
            "description": "The metrics.",
            "type": "object"
          },
          "queue_position": {
            "description": "The queue position.",
            "type": "integer"
          },
          "request_id": {
            "description": "The request id.",
            "type": "string"
          },
          "response_url": {
            "description": "The response url.",
            "type": "string"
          },
          "status": {
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ],
            "type": "string"
          },
          "status_url": {
            "description": "The status url.",
            "type": "string"
          }
        },
        "required": [
          "status",
          "request_id"
        ],
        "type": "object"
      },
      "ReferenceCondition": {
        "description": "One ordered Ref2VA media condition.",
        "properties": {
          "type": {
            "description": "Reference modality. Cross-modality list order is semantic.",
            "enum": [
              "image",
              "video",
              "audio"
            ],
            "title": "Type",
            "type": "string"
          },
          "url": {
            "description": "URL of the reference media.",
            "minLength": 1,
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "type",
          "url"
        ],
        "title": "ReferenceCondition",
        "type": "object",
        "x-fal-order-properties": [
          "type",
          "url"
        ]
      }
    },
    "securitySchemes": {
      "apiKeyAuth": {
        "description": "Fal Key",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "The OpenAPI schema for the minimax/h3-max/reference-to-video queue.",
    "title": "Queue OpenAPI for minimax/h3-max/reference-to-video",
    "version": "1.0.0",
    "x-fal-metadata": {
      "about": "Reference To Video Turbo",
      "category": "image-to-video",
      "documentationUrl": "https://fal.ai/models/minimax/h3-max/reference-to-video/api",
      "endpointId": "minimax/h3-max/reference-to-video",
      "playgroundUrl": "https://fal.ai/models/minimax/h3-max/reference-to-video",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0aa84d7e/Weqd1RIL2EmDlzxnkQzCq.jpg"
    }
  },
  "openapi": "3.0.4",
  "paths": {
    "/minimax/h3-max/reference-to-video": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/H3MaxReferenceToVideoInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            },
            "description": "The request status."
          }
        }
      }
    },
    "/minimax/h3-max/reference-to-video/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/H3MaxReferenceToVideoOutput"
                }
              }
            },
            "description": "Result of the request."
          }
        }
      }
    },
    "/minimax/h3-max/reference-to-video/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "description": "Whether the request was cancelled successfully.",
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The request was cancelled."
          }
        }
      }
    },
    "/minimax/h3-max/reference-to-video/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "logs",
            "required": false,
            "schema": {
              "description": "Whether to include logs (`1`) in the response or not (`0`).",
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            },
            "description": "The request status."
          }
        }
      }
    }
  },
  "security": [
    {
      "apiKeyAuth": []
    }
  ],
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ]
}
