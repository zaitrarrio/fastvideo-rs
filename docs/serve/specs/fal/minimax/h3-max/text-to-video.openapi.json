{
  "components": {
    "schemas": {
      "File": {
        "properties": {
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The mime type of the file.",
            "examples": [
              "image/png"
            ],
            "title": "Content Type"
          },
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "title": "File Name"
          },
          "file_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The size of the file in bytes.",
            "examples": [
              4404019
            ],
            "title": "File Size"
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "File",
        "type": "object",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ]
      },
      "H3MaxTextToVideoInput": {
        "description": "Public H3 Max input; Max Turbo keeps the shared Turbo input contract.",
        "properties": {
          "aspect_ratio": {
            "default": "16:9",
            "description": "The aspect ratio of the generated video.",
            "enum": [
              "21:9",
              "16:9",
              "4:3",
              "1:1",
              "3:4",
              "9:16"
            ],
            "title": "Aspect Ratio",
            "type": "string"
          },
          "duration": {
            "default": 5,
            "description": "Video length in seconds. The output can run up to about 0.7 s longer than requested. Use at least 2 s with target_audio_url.",
            "maximum": 15,
            "minimum": 0.92,
            "title": "Duration",
            "type": "number"
          },
          "enable_safety_checker": {
            "default": true,
            "description": "If set to true, the safety checker will be enabled.",
            "title": "Enable Safety Checker",
            "type": "boolean"
          },
          "prompt": {
            "description": "Text prompt for video generation",
            "examples": [
              "A white kitten chases a butterfly across a sunlit garden. Gentle camera tracking, natural movement, soft afternoon light filtering through the leaves."
            ],
            "maxLength": 50000,
            "minLength": 1,
            "title": "Prompt",
            "type": "string"
          },
          "prompt_expansion_mode": {
            "default": "balanced",
            "description": "How much effort to spend rewriting the prompt before generation. 'disabled' skips prompt expansion. 'balanced' returns in about a second. 'quality' spends up to ~30s on a richer prompt.",
            "examples": [
              "disabled",
              "balanced",
              "quality"
            ],
            "title": "Prompt Expansion Mode",
            "type": "string"
          },
          "resolution": {
            "default": "768P",
            "description": "The native generation resolution, or 1080P latent refinement from a native 768P source.",
            "enum": [
              "480P",
              "768P",
              "1080P"
            ],
            "title": "Resolution",
            "type": "string"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Random seed. A random seed is selected when omitted.",
            "title": "Seed"
          },
          "sync_mode": {
            "default": false,
            "description": "Return the generated video as base64 instead of a CDN URL.",
            "title": "Sync Mode",
            "type": "boolean"
          },
          "target_audio_url": {
            "anyOf": [
              {
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional URL of an audio clip at least 2 seconds long (maximum 15 MB) to pin to the generated soundtrack. Longer clips are trimmed to the generated video's length, keeping the beginning. The original audio replaces the output soundtrack, padded with silence if shorter than the video, without changing playback speed. Exceptionally high sample rates may be resampled to 96 kHz. Accepts an HTTP(S) URL or a base64 data URI.",
            "title": "Target Audio Url"
          }
        },
        "required": [
          "prompt",
          "prompt_expansion_mode"
        ],
        "title": "MaxTextToVideoHailuo03Input",
        "type": "object",
        "x-fal-order-properties": [
          "prompt",
          "duration",
          "resolution",
          "seed",
          "enable_safety_checker",
          "sync_mode",
          "prompt_expansion_mode",
          "target_audio_url",
          "aspect_ratio"
        ]
      },
      "H3MaxTextToVideoOutput": {
        "properties": {
          "expanded_prompt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The prompt after expansion, as sent to the model. Null when prompt expansion was disabled, left the prompt unchanged, or was performed internally by MiniMax's hosted API.",
            "title": "Expanded Prompt"
          },
          "timings": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Timing breakdown in seconds. 'inference' is the DiT denoising time on the GPU backend. Null on routes that do not report backend timings.",
            "title": "Timings"
          },
          "video": {
            "$ref": "#/components/schemas/File",
            "description": "The generated video",
            "examples": [
              {
                "content_type": "video/mp4",
                "file_name": "--prs89fkHtWW406fmEs__NRhTqNku.mp4",
                "file_size": 6463396,
                "url": "https://v3b.fal.media/files/b/0aa46818/--prs89fkHtWW406fmEs__NRhTqNku.mp4"
              }
            ]
          }
        },
        "required": [
          "video"
        ],
        "title": "TurboTextToVideoHailuo03Output",
        "type": "object",
        "x-fal-order-properties": [
          "video",
          "expanded_prompt",
          "timings"
        ]
      },
      "QueueStatus": {
        "properties": {
          "cancel_url": {
            "description": "The cancel url.",
            "type": "string"
          },
          "logs": {
            "additionalProperties": true,
            "description": "The logs.",
            "type": "object"
          },
          "metrics": {
            "additionalProperties": true,
            "description": "The metrics.",
            "type": "object"
          },
          "queue_position": {
            "description": "The queue position.",
            "type": "integer"
          },
          "request_id": {
            "description": "The request id.",
            "type": "string"
          },
          "response_url": {
            "description": "The response url.",
            "type": "string"
          },
          "status": {
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ],
            "type": "string"
          },
          "status_url": {
            "description": "The status url.",
            "type": "string"
          }
        },
        "required": [
          "status",
          "request_id"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "apiKeyAuth": {
        "description": "Fal Key",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "The OpenAPI schema for the minimax/h3-max/text-to-video queue.",
    "title": "Queue OpenAPI for minimax/h3-max/text-to-video",
    "version": "1.0.0",
    "x-fal-metadata": {
      "about": "Text To Video Turbo",
      "category": "text-to-video",
      "documentationUrl": "https://fal.ai/models/minimax/h3-max/text-to-video/api",
      "endpointId": "minimax/h3-max/text-to-video",
      "playgroundUrl": "https://fal.ai/models/minimax/h3-max/text-to-video",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0aa7657e/LlavC7cCdZ_GGyvyglA82.jpg"
    }
  },
  "openapi": "3.0.4",
  "paths": {
    "/minimax/h3-max/text-to-video": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/H3MaxTextToVideoInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            },
            "description": "The request status."
          }
        }
      }
    },
    "/minimax/h3-max/text-to-video/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/H3MaxTextToVideoOutput"
                }
              }
            },
            "description": "Result of the request."
          }
        }
      }
    },
    "/minimax/h3-max/text-to-video/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "description": "Whether the request was cancelled successfully.",
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The request was cancelled."
          }
        }
      }
    },
    "/minimax/h3-max/text-to-video/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "logs",
            "required": false,
            "schema": {
              "description": "Whether to include logs (`1`) in the response or not (`0`).",
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            },
            "description": "The request status."
          }
        }
      }
    }
  },
  "security": [
    {
      "apiKeyAuth": []
    }
  ],
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ]
}
