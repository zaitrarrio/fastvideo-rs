                      "description": "Whether the request was cancelled successfully.",
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The request was cancelled."
          }
        }
      }
    },
    "/minimax/h3-max-turbo/image-to-video/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
