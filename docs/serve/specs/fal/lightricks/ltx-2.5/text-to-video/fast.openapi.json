{
  "components": {
    "schemas": {
      "Ltx25TextToVideoFastInput": {
        "properties": {
          "aspect_ratio": {
            "default": "16:9",
            "description": "The aspect ratio of the generated video",
            "enum": [
              "16:9",
              "9:16"
            ],
            "title": "Aspect Ratio",
            "type": "string"
          },
          "camera_motion": {
            "anyOf": [
              {
                "enum": [
                  "dolly_in",
                  "dolly_out",
                  "dolly_left",
                  "dolly_right",
                  "jib_up",
                  "jib_down",
                  "static",
                  "focus_shift"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional camera motion applied to the generated video.",
            "title": "Camera Motion"
          },
          "duration": {
            "default": "auto",
            "description": "The duration of the generated video in seconds. At 720p and 1080p, 24 or 25 FPS supports up to 20 seconds, while 48 or 50 FPS supports up to 10 seconds. At 1440p and 2160p, all frame rates support up to 10 seconds. Set to 'auto' to let the model choose the duration automatically.",
            "enum": [
              6,
              8,
              10,
              12,
              14,
              16,
              18,
              20,
              "auto"
            ],
            "title": "Duration"
          },
          "fps": {
            "default": 25,
            "description": "The frames per second of the generated video.",
            "enum": [
              24,
              25,
              48,
              50
            ],
            "title": "Frames per Second",
            "type": "integer"
          },
          "generate_audio": {
            "default": true,
            "description": "Whether to generate audio for the generated video",
            "title": "Generate Audio",
            "type": "boolean"
          },
          "prompt": {
            "description": "The prompt to use for the generated video",
            "examples": [
              "Through-the-veil shot of a bride's face during an Indian wedding ceremony, camera positioned behind the sheer red dupatta fabric, the embroidered pattern creating a textured overlay on her face, her eyes lined with kohl looking down at henna-covered hands, marigold garlands in soft background bokeh, 85mm f/1.2 focused through the fabric layer, warm tungsten and candlelight, Mira Nair Monsoon Wedding intimacy"
            ],
            "maxLength": 5000,
            "minLength": 1,
            "title": "Prompt",
            "type": "string"
          },
          "resolution": {
            "default": "1080p",
            "description": "The resolution of the generated video.",
            "enum": [
              "720p",
              "1080p",
              "1440p",
              "2160p"
            ],
            "title": "Resolution",
            "type": "string"
          }
        },
        "required": [
          "prompt"
        ],
        "title": "LTXV25TextToVideoFastRequest",
        "type": "object",
        "x-fal-order-properties": [
          "prompt",
          "duration",
          "resolution",
          "aspect_ratio",
          "fps",
          "generate_audio",
          "camera_motion"
        ]
      },
