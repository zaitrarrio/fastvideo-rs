{
  "components": {
    "schemas": {
      "Ltx23RetakeVideoInput": {
        "properties": {
          "duration": {
            "default": 5,
            "description": "The duration of the video to retake in seconds",
            "maximum": 20,
            "minimum": 2,
            "title": "Duration",
            "type": "number"
          },
          "enable_safety_checker": {
            "default": true,
            "description": "Authorized callers may set false to request relaxed screening.",
            "title": "Enable Safety Checker",
            "type": "boolean"
          },
          "prompt": {
            "description": "The prompt to retake the video with",
            "examples": [
              "Change flower to red rose"
            ],
            "maxLength": 5000,
            "minLength": 1,
            "title": "Prompt",
            "type": "string"
          },
          "retake_mode": {
            "default": "replace_audio_and_video",
            "description": "The retake mode to use for the retake",
            "enum": [
              "replace_audio",
              "replace_video",
              "replace_audio_and_video"
            ],
            "title": "Retake Mode",
            "type": "string"
          },
          "start_time": {
            "default": 0,
            "description": "The start time of the video to retake in seconds",
            "maximum": 20,
            "minimum": 0,
            "title": "Start Time",
            "type": "number"
          },
          "video_url": {
            "description": "The URL of the video to retake",
            "examples": [
              "https://v3b.fal.media/files/b/0a90e00e/eNWXGtaGyZO--e6KcJh-3_171_video.mp4"
            ],
            "title": "Video URL",
            "type": "string"
          }
        },
        "required": [
          "video_url",
          "prompt"
        ],
        "title": "LTXV23RetakeVideoRequest",
        "type": "object",
        "x-fal-order-properties": [
          "video_url",
          "prompt",
          "start_time",
          "duration",
          "retake_mode",
          "enable_safety_checker"
        ]
      },
      "Ltx23RetakeVideoOutput": {
        "properties": {
          "video": {
            "$ref": "#/components/schemas/VideoFile",
            "description": "The generated video file",
            "examples": [
              {
                "content_type": "video/mp4",
                "file_name": "xvl9SlF6b7a8327wKJDvm_JW6crfr3.mp4",
                "url": "https://v3b.fal.media/files/b/0a90e00f/xvl9SlF6b7a8327wKJDvm_JW6crfr3.mp4"
              }
            ]
          }
        },
        "required": [
          "video"
        ],
        "title": "LTXV23RetakeVideoResponse",
        "type": "object",
        "x-fal-order-properties": [
          "video"
        ]
      },
      "QueueStatus": {
        "properties": {
          "cancel_url": {
            "description": "The cancel url.",
            "type": "string"
          },
          "logs": {
            "additionalProperties": true,
            "description": "The logs.",
            "type": "object"
          },
          "metrics": {
            "additionalProperties": true,
            "description": "The metrics.",
            "type": "object"
          },
          "queue_position": {
            "description": "The queue position.",
            "type": "integer"
          },
          "request_id": {
            "description": "The request id.",
            "type": "string"
          },
          "response_url": {
            "description": "The response url.",
            "type": "string"
          },
          "status": {
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ],
            "type": "string"
          },
          "status_url": {
            "description": "The status url.",
            "type": "string"
          }
        },
        "required": [
          "status",
          "request_id"
        ],
        "type": "object"
      },
      "VideoFile": {
        "properties": {
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The mime type of the file.",
            "examples": [
              "image/png"
            ],
            "title": "Content Type"
          },
          "duration": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "The duration of the video",
            "title": "Duration"
          },
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "title": "File Name"
          },
          "file_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The size of the file in bytes.",
            "examples": [
              4404019
            ],
            "title": "File Size"
          },
          "fps": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "The FPS of the video",
            "title": "Fps"
          },
          "height": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The height of the video",
            "title": "Height"
          },
          "num_frames": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The number of frames in the video",
            "title": "Num Frames"
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "title": "Url",
            "type": "string"
          },
          "width": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The width of the video",
            "title": "Width"
          }
        },
        "required": [
          "url"
        ],
        "title": "VideoFile",
        "type": "object",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height",
          "fps",
          "duration",
          "num_frames"
        ]
      }
    },
    "securitySchemes": {
      "apiKeyAuth": {
        "description": "Fal Key",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "The OpenAPI schema for the fal-ai/ltx-2.3/retake-video queue.",
    "title": "Queue OpenAPI for fal-ai/ltx-2.3/retake-video",
    "version": "1.0.0",
    "x-fal-metadata": {
      "about": "Retake a video section with a new prompt using LTX 2.3.",
      "category": "video-to-video",
      "documentationUrl": "https://fal.ai/models/fal-ai/ltx-2.3/retake-video/api",
      "endpointId": "fal-ai/ltx-2.3/retake-video",
      "playgroundUrl": "https://fal.ai/models/fal-ai/ltx-2.3/retake-video",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a90dfa3/n0x-itbsnTjyU1PO9Nvih_9d720bc367dd4121bea3d31100f1aecf.jpg"
    }
  },
  "openapi": "3.0.4",
  "paths": {
    "/fal-ai/ltx-2.3/retake-video": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Ltx23RetakeVideoInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            },
            "description": "The request status."
          }
        }
      }
    },
    "/fal-ai/ltx-2.3/retake-video/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ltx23RetakeVideoOutput"
                }
              }
            },
            "description": "Result of the request."
          }
        }
      }
    },
    "/fal-ai/ltx-2.3/retake-video/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "description": "Whether the request was cancelled successfully.",
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The request was cancelled."
          }
        }
      }
    },
    "/fal-ai/ltx-2.3/retake-video/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "logs",
            "required": false,
            "schema": {
              "description": "Whether to include logs (`1`) in the response or not (`0`).",
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            },
            "description": "The request status."
          }
        }
      }
    }
  },
  "security": [
    {
      "apiKeyAuth": []
    }
  ],
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ]
}
