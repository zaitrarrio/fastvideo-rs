{
  "components": {
    "schemas": {
      "Ltx23ExtendVideoInput": {
        "properties": {
          "context": {
            "anyOf": [
              {
                "maximum": 20,
                "minimum": 1,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Number of seconds from the input video to use as context for the extension (minimum 1 second, maximum 20 seconds). If not provided, defaults to maximize available context within the 505 frame limit.",
            "title": "Context"
          },
          "duration": {
            "default": 5,
            "description": "Duration in seconds to extend the video. Minimum 2 seconds, maximum 20 seconds.",
            "maximum": 20,
            "minimum": 2,
            "title": "Duration",
            "type": "number"
          },
          "enable_safety_checker": {
            "default": true,
            "description": "Authorized callers may set false to request relaxed screening.",
            "title": "Enable Safety Checker",
            "type": "boolean"
          },
          "mode": {
            "default": "end",
            "description": "Where to extend the video: 'end' extends at the end, 'start' extends at the beginning.",
            "enum": [
              "start",
              "end"
            ],
            "title": "Mode",
            "type": "string"
          },
          "prompt": {
            "anyOf": [
              {
                "maxLength": 5000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Description of what should happen in the extended portion of the video.",
            "examples": [
              "Continue the motion smoothly"
            ],
            "title": "Prompt"
          },
          "video_url": {
            "description": "The URL of the video to extend",
            "examples": [
              "https://v3b.fal.media/files/b/0a90e01f/SWYdQyTBCPWYOLgfg5Jw2_004_video.mp4"
            ],
            "title": "Video URL",
            "type": "string"
          }
        },
        "required": [
          "video_url"
        ],
        "title": "LTXV23ExtendVideoRequest",
        "type": "object",
        "x-fal-order-properties": [
          "video_url",
          "prompt",
          "duration",
          "mode",
          "context",
          "enable_safety_checker"
        ]
      },
      "Ltx23ExtendVideoOutput": {
        "properties": {
          "video": {
            "$ref": "#/components/schemas/VideoFile",
            "description": "The extended video file",
            "examples": [
              {
                "content_type": "video/mp4",
                "file_name": "sQT2ORTL4ISEeLv3mRdF0_rGO62gwz.mp4",
                "url": "https://v3b.fal.media/files/b/0a90e020/sQT2ORTL4ISEeLv3mRdF0_rGO62gwz.mp4"
              }
            ]
          }
        },
        "required": [
          "video"
        ],
        "title": "LTXV23ExtendVideoResponse",
        "type": "object",
        "x-fal-order-properties": [
          "video"
        ]
      },
      "QueueStatus": {
        "properties": {
          "cancel_url": {
            "description": "The cancel url.",
            "type": "string"
          },
          "logs": {
            "additionalProperties": true,
            "description": "The logs.",
            "type": "object"
          },
          "metrics": {
            "additionalProperties": true,
            "description": "The metrics.",
            "type": "object"
          },
          "queue_position": {
            "description": "The queue position.",
            "type": "integer"
          },
          "request_id": {
            "description": "The request id.",
            "type": "string"
          },
          "response_url": {
            "description": "The response url.",
            "type": "string"
          },
          "status": {
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ],
            "type": "string"
          },
          "status_url": {
            "description": "The status url.",
            "type": "string"
          }
        },
        "required": [
          "status",
          "request_id"
        ],
        "type": "object"
      },
      "VideoFile": {
        "properties": {
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The mime type of the file.",
            "examples": [
              "image/png"
            ],
            "title": "Content Type"
          },
          "duration": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "The duration of the video",
            "title": "Duration"
          },
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "title": "File Name"
          },
          "file_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The size of the file in bytes.",
            "examples": [
              4404019
            ],
            "title": "File Size"
          },
          "fps": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "The FPS of the video",
            "title": "Fps"
          },
          "height": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The height of the video",
            "title": "Height"
          },
          "num_frames": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The number of frames in the video",
            "title": "Num Frames"
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "title": "Url",
            "type": "string"
          },
          "width": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The width of the video",
            "title": "Width"
          }
        },
        "required": [
          "url"
        ],
        "title": "VideoFile",
        "type": "object",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height",
          "fps",
          "duration",
          "num_frames"
        ]
      }
    },
    "securitySchemes": {
      "apiKeyAuth": {
        "description": "Fal Key",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "The OpenAPI schema for the fal-ai/ltx-2.3/extend-video queue.",
    "title": "Queue OpenAPI for fal-ai/ltx-2.3/extend-video",
    "version": "1.0.0",
    "x-fal-metadata": {
      "about": "Extend a video by generating additional frames at the beginning or end using LTX 2.3.",
      "category": "video-to-video",
      "documentationUrl": "https://fal.ai/models/fal-ai/ltx-2.3/extend-video/api",
      "endpointId": "fal-ai/ltx-2.3/extend-video",
      "playgroundUrl": "https://fal.ai/models/fal-ai/ltx-2.3/extend-video",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a90df98/94vlBeSzUCH4iQ2ZLYjPn_f1cc45dc9b69411e8c7271b4df43798f.jpg"
    }
  },
  "openapi": "3.0.4",
  "paths": {
    "/fal-ai/ltx-2.3/extend-video": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Ltx23ExtendVideoInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            },
            "description": "The request status."
          }
        }
      }
    },
    "/fal-ai/ltx-2.3/extend-video/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ltx23ExtendVideoOutput"
                }
              }
            },
            "description": "Result of the request."
          }
        }
      }
    },
    "/fal-ai/ltx-2.3/extend-video/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "description": "Whether the request was cancelled successfully.",
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The request was cancelled."
          }
        }
      }
    },
    "/fal-ai/ltx-2.3/extend-video/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "logs",
            "required": false,
            "schema": {
              "description": "Whether to include logs (`1`) in the response or not (`0`).",
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            },
            "description": "The request status."
          }
        }
      }
    }
  },
  "security": [
    {
      "apiKeyAuth": []
    }
  ],
  "servers": [
