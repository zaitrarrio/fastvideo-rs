# Copy to .env (gitignored), fill in, then: chmod 600 .env
# Read by scripts/gpu/*.sh. Variables already set in your shell take precedence.

# Vast.ai API key (console.vast.ai → Account → API Keys). Overrides ~/.config/vastai/vast_api_key.
VAST_API_KEY=

# Optional overrides
# VAST_SSH_KEY=~/.ssh/id_strobe_vast
# MAX_DPH=0.25
# MAX_MINUTES=40
# Default rentals use the slim GHCR image (no PyTorch). validate.sh picks a
# vastai/pytorch-based image only for tiers that need Python+torch:
#   VAST_IMAGE_FLAVOR=auto|slim|pytorch|oracle
# Force a specific tag (skips flavor selection; binary is uploaded):
#   VAST_IMAGE=ghcr.io/zaitrarrio/fastvideo-rs-vast-oracle:latest
# Pin the Vast base used when building those images:
#   FV_VAST_PYTORCH_IMAGE=vastai/pytorch:cuda-13.0.3-auto
