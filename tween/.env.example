# Tween local settings. Copy to .env (Taskfile) — `task tween:setup` does it
# and also writes .dev.vars (what `wrangler dev` reads) from these values.

# fv-serve the Worker talks to. Local Docker fake engine: 8000; mock: 8010.
TWEEN_ENGINE_URL=http://127.0.0.1:8000
# fv-serve API key. Docker: hashed into FV_API_KEYS by task tween:engine:up.
TWEEN_ENGINE_KEY=sk-local
# Studio sign-in token. Empty: no sign-in (local only; always set on staging).
TWEEN_ACCESS_TOKEN=

# Model ids per engine and tier. Empty: the fake engine's ids.
# Staging values live in wrangler.toml [env.staging.vars].
TWEEN_LTX_DRAFT_MODEL=
TWEEN_LTX_FINAL_MODEL=
TWEEN_H3_DRAFT_MODEL=
TWEEN_H3_FINAL_MODEL=
TWEEN_H3_REFERENCE_MODEL=

# Local stack ports and the engine image.
TWEEN_PORT=8787
TWEEN_ENGINE_PORT=8000
TWEEN_MOCK_PORT=8010
FV_SERVE_IMAGE=ghcr.io/zaitrarrio/fastvideo-rs-serve:cpu
