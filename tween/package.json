{
  "name": "fv-tween",
  "version": "0.1.0",
  "private": true,
  "description": "Tween: keyframe storyboards rendered by fv-serve (LTX and H3 side by side). Cloudflare Worker + static UI.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy:staging": "wrangler deploy --env staging",
    "db:migrate:local": "wrangler d1 migrations apply fv-tween --local",
    "db:migrate:staging": "wrangler d1 migrations apply fv-tween --env staging --remote",
    "test": "vitest run test/unit",
    "test:e2e": "vitest run test/e2e",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.143.0"
  }
}
